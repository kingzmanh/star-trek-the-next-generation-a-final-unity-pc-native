#include <windows.h>
1 RT_MANIFEST "setup.manifest"
GAMEEXE RCDATA "../build/release/game.exe"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PC Native fan port (github.com/kingzmanh)"
            VALUE "FileDescription", "Star Trek TNG A Final Unity PC Native - Setup"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "setup"
            VALUE "LegalCopyright", "Port code: open source. Game: its owners."
            VALUE "OriginalFilename", "setup.exe"
            VALUE "ProductName", "Star Trek TNG A Final Unity PC Native"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
